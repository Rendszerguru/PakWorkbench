<Project>

	<PropertyGroup>
		<BaseOutputPath>build\bin\</BaseOutputPath>
		<BaseIntermediateOutputPath>build\obj\</BaseIntermediateOutputPath>
	</PropertyGroup>

	<!-- SDK begin import -->
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

	<PropertyGroup>

		<!-- Application -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Version>1.0.0</Version>

		<!-- Language -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- UI -->
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>

		<!-- Build -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- Publish -->
		<PublishDir>publish\$(Configuration)\</PublishDir>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<IncludeNativeLibrariesForSingleFile>true</IncludeNativeLibrariesForSingleFile>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

		<!-- Misc -->
		<AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
		<ApplicationIcon>src\ext\res\icon.ico</ApplicationIcon>

	</PropertyGroup>

	<!-- Automatically publish after every successful build -->
	<Target Name="AutoPublishAfterBuild" AfterTargets="Build" Condition="'$(DeployOnBuild)' != 'true'">

		<MSBuild Projects="$(MSBuildProjectFullPath)"
				 Targets="Publish"
				 Properties="Configuration=$(Configuration);
							 RuntimeIdentifier=$(RuntimeIdentifier);
							 PublishSingleFile=$(PublishSingleFile);
							 IncludeNativeLibrariesForSingleFile=$(IncludeNativeLibrariesForSingleFile);
							 IncludeAllContentForSelfExtract=$(IncludeAllContentForSelfExtract);
							 DeployOnBuild=true" />

	</Target>

	<!-- Embedded Resources (Assets, Fonts, Keywords) -->
	<ItemGroup>
		<EmbeddedResource Include="src\ext\res\icon.ico" />
		<EmbeddedResource Include="src\ext\res\Roboto-Regular.ttf" />
		<EmbeddedResource Include="src\ext\res\kw*.txt" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>

		<PackageReference Include="DiffPlex" Version="1.9.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />

	</ItemGroup>

	<!-- SDK end import -->
	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>